{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "pnpm --filter @workspace/sentinel-ehr build",
  "outputDirectory": "public",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/(privacy|terms)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}